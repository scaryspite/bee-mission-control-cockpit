.private-gate {
  position: relative;
  display: grid;
  min-height: 100vh;
  place-items: center;
  overflow: hidden;
  padding: 32px clamp(20px, 6vw, 92px);
  color: var(--text);
  background:
    linear-gradient(115deg, rgba(7, 9, 13, 0.96), rgba(12, 18, 25, 0.84)),
    radial-gradient(circle at 70% 30%, rgba(121, 215, 229, 0.14), transparent 26rem),
    var(--void);
}

.private-gate::before {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(90deg, transparent 0 12%, rgba(121, 215, 229, 0.1) 12% 12.1%, transparent 12.1% 100%),
    linear-gradient(rgba(121, 215, 229, 0.06) 1px, transparent 1px);
  background-size: 100% 100%, 100% 48px;
  content: "";
  opacity: 0.42;
}

.private-gate-corner,
.private-gate-footer,
.private-gate-kicker,
.private-gate-message {
  font-family: var(--font-display);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.private-gate-corner {
  position: absolute;
  top: 28px;
  left: clamp(20px, 6vw, 92px);
  color: var(--early-purple);
  font-size: 0.66rem;
}

.private-gate-content {
  position: relative;
  width: min(620px, 100%);
  padding: 16vh 0 12vh;
}

.private-gate-kicker {
  margin: 0 0 18px;
  color: var(--moon-blue);
  font-size: 0.7rem;
}

.private-gate-content h1 {
  max-width: 11ch;
  margin: 0;
  color: var(--text);
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 8vw, 6rem);
  font-weight: 700;
  line-height: 0.95;
  text-transform: uppercase;
}

.private-gate-copy {
  max-width: 42ch;
  margin: 24px 0 34px;
  color: var(--text-dim);
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.65;
}

.private-gate-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 16px;
  width: min(540px, 100%);
  padding-bottom: 8px;
  border-bottom: 1px solid var(--soft-pink);
}

.private-gate-form label {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.private-gate-form input {
  min-width: 0;
  padding: 10px 0;
  border: 0;
  color: var(--text);
  background: transparent;
  font: 0.86rem var(--font-body);
}

.private-gate-form input::placeholder {
  color: var(--text-dim);
}

.private-gate-form input:focus {
  outline: none;
}

.private-gate-form button,
.private-gate-local {
  padding: 9px 0;
  border: 0;
  color: var(--soft-pink);
  background: transparent;
  cursor: pointer;
  font: 0.68rem var(--font-display);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.private-gate-form button:hover,
.private-gate-form button:focus-visible,
.private-gate-local:hover,
.private-gate-local:focus-visible {
  color: var(--text);
}

.private-gate-local {
  margin-top: 20px;
  color: var(--moon-blue);
}

.private-gate-message {
  min-height: 1.2em;
  margin: 22px 0 0;
  color: var(--text-dim);
  font-size: 0.58rem;
  line-height: 1.6;
}

.private-gate-footer {
  position: absolute;
  right: clamp(20px, 6vw, 92px);
  bottom: 28px;
  left: clamp(20px, 6vw, 92px);
  display: flex;
  justify-content: space-between;
  gap: 18px;
  color: var(--text-dim);
  font-size: 0.58rem;
}

@media (max-width: 600px) {
  .private-gate {
    align-items: start;
    padding-top: 120px;
  }

  .private-gate-content {
    padding: 0 0 120px;
  }

  .private-gate-form {
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .private-gate-form button {
    justify-self: start;
  }

  .private-gate-footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 6px;
  }
}
